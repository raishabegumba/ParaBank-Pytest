# =========================
# Reports and Logs (SAFE RULES)
# =========================

# Ignore only generated/temporary report data
reports/allure-results/
reports/allure-report/
reports/allure-report-fixed/

# Ignore raw data files (if needed)
reports/**/*.json
logs/**/*.log

# IMPORTANT:
# DO NOT ignore HTML reports globally
# (so test_results.html will be tracked)

# =========================
# Keep folders tracked in Git
# =========================
!reports/
!reports/html/
!logs/

# Keep placeholders
!reports/.gitkeep
!reports/html/.gitkeep
!logs/.gitkeep

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Build
# =========================
dist/
build/
*.egg